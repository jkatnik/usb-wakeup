<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>USB Wake-up Cinnamon Applet</vendor>

  <action id="org.cinnamon.applets.usbwakeup.set-wakeup">
    <description>Zmiana ustawienia wybudzania z USB</description>
    <message>Aby zmienic, ktore urzadzenia USB moga wybudzac komputer z uspienia, wymagane sa uprawnienia administratora</message>
    <icon_name>drive-removable-media</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/usb-wakeup-helper.sh</annotate>
  </action>

</policyconfig>
