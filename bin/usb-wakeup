def _detect_lang():
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "")
        if value.lower().startswith("pl"):
            return "pl"
        if value:
            break
    try:
        lang_code = locale.getlocale()[0] or ""
        if lang_code.lower().startswith("pl"):
            return "pl"
    except (ValueError, TypeError):
        pass
    return "en"


T = STRINGS[_detect_lang()]


def read_file(path):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except OSError:
        return None


def load_label_overrides():
    try:
        with open(LABELS_FILE, "r") as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_label_overrides(overrides):
    os.makedirs(os.path.dirname(LABELS_FILE), exist_ok=True)
    tmp = LABELS_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(overrides, f, indent=2, sort_keys=True)
    os.replace(tmp, LABELS_FILE)


def set_label_override(key, custom_label):
    overrides = load_label_overrides()
    if custom_label:
        overrides[key] = custom_label
    else:
        overrides.pop(key, None)
    save_label_overrides(overrides)


def list_devices():
    devices = []
    try:
        entries = sorted(os.listdir(SYSFS_USB_ROOT))
    except OSError as e:
        print(T["cannot_read"].format(path=SYSFS_USB_ROOT, err=e), file=sys.stderr)
        return devices

    overrides = load_label_overrides()

    for name in entries:
        dev_path = os.path.join(SYSFS_USB_ROOT, name)
        wakeup_path = os.path.join(dev_path, "power", "wakeup")
        if not os.path.isfile(wakeup_path):
            continue

        wakeup = read_file(wakeup_path)
        if wakeup is None:
            continue

        manufacturer = read_file(os.path.join(dev_path, "manufacturer")) or ""
        product = read_file(os.path.join(dev_path, "product")) or ""
        vendor_id = read_file(os.path.join(dev_path, "idVendor")) or ""
        product_id = read_file(os.path.join(dev_path, "idProduct")) or ""

        label_parts = [p for p in (manufacturer, product) if p]
        default_label = " ".join(label_parts) if label_parts else f"USB {vendor_id}:{product_id}"

        key = f"{vendor_id}:{product_id}" if vendor_id and product_id else f"id:{name}"
        label = overrides.get(key) or default_label

        devices.append({
            "id": name,
            "key": key,
            "label": label,
            "default_label": default_label,
            "enabled": wakeup == "enabled",
        })

    devices.sort(key=lambda d: d["label"].lower())
    return devices


def set_wakeup(device_id, enable):
    action = "enabled" if enable else "disabled"
    result = subprocess.run(
        ["pkexec", HELPER_SCRIPT, device_id, action],
        capture_output=True,
        text=True,
    )
    return result.returncode == 0, result.stderr.strip()


def run_cli_list():
    devices = list_devices()
    if not devices:
        print(T["no_devices"])
        return 0

    label_width = max(len(d["label"]) for d in devices)
    status_width = max(len(T["state_on"]), len(T["state_off"]))
    for d in devices:
        status = T["state_on"] if d["enabled"] else T["state_off"]
        print(f"{d['id']:<12} {status:<{status_width}}  {d['label']:<{label_width}}")
    return 0


def run_cli_set(device_id, enable):
    ok, err = set_wakeup(device_id, enable)
    if ok:
        state = T["state_on"] if enable else T["state_off"]
        print(T["set_ok"].format(id=device_id, state=state))
        return 0
    else:
        print(T["set_error"].format(err=err), file=sys.stderr)
        return 1


def run_text_menu():
    errors = curses.wrapper(_text_menu_loop)
    for err in errors:
        print(err, file=sys.stderr)
    return 1 if errors else 0


def _text_menu_loop(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_WHITE)
    try:
        curses.set_escdelay(25)
    except AttributeError:
        pass

    devices = list_devices()
    original = {d["id"]: d["enabled"] for d in devices}
    labels = {d["id"]: d["label"] for d in devices}
    pending = dict(original)
    selected = 0

    while True:
        if devices:
            selected = max(0, min(selected, len(devices) - 1))

        stdscr.erase()
        max_y, max_x = stdscr.getmaxyx()

        def put(y, x, text, attr=curses.A_NORMAL):
            if 0 <= y < max_y:
                stdscr.addnstr(y, x, text, max(0, max_x - x - 1), attr)

        put(0, 0, T["menu_header"], curses.A_BOLD)

        row = 2
        if not devices:
            put(row, 0, T["no_devices"])
            row += 1
        else:
            for i, d in enumerate(devices):
                mark = "x" if pending[d["id"]] else " "
                changed = "*" if pending[d["id"]] != original[d["id"]] else " "
                line = f"{changed}[{mark}] {d['label']} ({d['id']})"
                attr = curses.color_pair(1) if i == selected else curses.A_NORMAL
                put(row + i, 0, line, attr)
            row += len(devices)

        put(row + 1, 0, T["menu_nav_help"])

        stdscr.refresh()

        key = stdscr.getch()

        if key in (curses.KEY_UP, ord('k')):
            if devices:
                selected = (selected - 1) % len(devices)
        elif key in (curses.KEY_DOWN, ord('j')):
            if devices:
                selected = (selected + 1) % len(devices)
        elif key == ord(' '):
            if devices:
                dev_id = devices[selected]["id"]
                pending[dev_id] = not pending[dev_id]
        elif key in (curses.KEY_ENTER, 10, 13):
            errors = []
            for dev_id, want in pending.items():
                if want != original[dev_id]:
                    ok, err = set_wakeup(dev_id, want)
                    if not ok:
                        errors.append(T["menu_save_error"].format(device=labels.get(dev_id, dev_id), err=err))
            return errors
        elif key == 27:
            return []


def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib, Gdk

    class UsbWakeupWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title=T["gui_title"])
            self.set_default_size(900, 600)
            self.set_border_width(10)
            self.set_icon_name("drive-removable-media")
            self.set_position(Gtk.WindowPosition.CENTER)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            self.add(vbox)

            header = Gtk.Label(label=T["menu_header"])
            header.set_xalign(0)
            vbox.pack_start(header, False, False, 0)

            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            vbox.pack_start(scroller, True, True, 0)

            self.listbox = Gtk.ListBox()
            self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
            scroller.add(self.listbox)

            button_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            vbox.pack_start(button_box, False, False, 0)

            refresh_btn = Gtk.Button(label=T["gui_refresh"])
            refresh_btn.connect("clicked", lambda b: self.reload())
            button_box.pack_start(refresh_btn, False, False, 0)

            close_btn = Gtk.Button(label=T["gui_close"])
            close_btn.connect("clicked", lambda b: self.close())
            button_box.pack_end(close_btn, False, False, 0)

            self.reload()

        def reload(self):
            for child in self.listbox.get_children():
                self.listbox.remove(child)

            devices = list_devices()

            if not devices:
                row = Gtk.ListBoxRow()
                row.set_selectable(False)
                label = Gtk.Label(label=T["no_devices"])
                label.set_xalign(0)
                label.set_margin_top(6)
                label.set_margin_bottom(6)
                label.set_margin_start(6)
                row.add(label)
                self.listbox.add(row)
            else:
                for dev in devices:
                    self.listbox.add(self._make_row(dev))

            self.listbox.show_all()

        def _make_row(self, dev):
            row = Gtk.ListBoxRow()
            row.set_selectable(False)
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            hbox.set_margin_top(4)
            hbox.set_margin_bottom(4)
            hbox.set_margin_start(6)
            hbox.set_margin_end(6)
            row.add(hbox)

            label = Gtk.Label(label=f"{dev['label']} ({dev['id']})")
            label.set_xalign(0)
            hbox.pack_start(label, True, True, 0)

            rename_btn = Gtk.Button()
            rename_btn.set_relief(Gtk.ReliefStyle.NONE)
            rename_btn.set_image(Gtk.Image.new_from_icon_name("document-edit-symbolic", Gtk.IconSize.BUTTON))
            rename_btn.set_tooltip_text(T["gui_rename_tooltip"])
            rename_btn.connect("clicked", self._start_inline_edit, hbox, label, dev)
            hbox.pack_end(rename_btn, False, False, 0)

            switch = Gtk.Switch()
            switch.set_active(dev["enabled"])
            switch.set_valign(Gtk.Align.CENTER)
            switch.connect("state-set", self._on_switch_toggled, dev)
            hbox.pack_end(switch, False, False, 0)

            return row

        def _start_inline_edit(self, button, hbox, label, dev):
            entry = Gtk.Entry()
            entry.set_text(dev["label"])
            hbox.remove(label)
            hbox.pack_start(entry, True, True, 0)
            hbox.reorder_child(entry, 0)
            button.set_sensitive(False)
            entry.show()
            entry.grab_focus()
            entry.set_position(-1)
            entry.select_region(0, -1)

            state = {"done": False}

            def finish(save):
                if state["done"]:
                    return
                state["done"] = True
                if save:
                    new_label = entry.get_text().strip()
                    if new_label and new_label != dev["default_label"]:
                        set_label_override(dev["key"], new_label)
                    else:
                        set_label_override(dev["key"], None)
                GLib.idle_add(self.reload)

            def on_focus_out(widget, event):
                finish(True)
                return False

            entry.connect("activate", lambda w: finish(True))
            entry.connect("focus-out-event", on_focus_out)

            def on_key_press(widget, event):
                if event.keyval == Gdk.KEY_Escape:
                    finish(False)
                    return True
                return False

            entry.connect("key-press-event", on_key_press)

        def _on_switch_toggled(self, switch, state, dev):
            switch.set_sensitive(False)
            GLib.idle_add(self._do_set_and_reenable, switch, dev, state)
            return True

        def _do_set_and_reenable(self, switch, dev, state):
            ok, err = set_wakeup(dev["id"], state)
            switch.set_sensitive(True)
            if ok:
                switch.set_state(state)
            else:
                switch.set_state(not state)
                switch.set_active(not state)
                dialog = Gtk.MessageDialog(
                    transient_for=self,
                    modal=True,
                    message_type=Gtk.MessageType.ERROR,
                    buttons=Gtk.ButtonsType.OK,
                    text=T["gui_error_title"].format(device=dev["label"]),
                )
                dialog.format_secondary_text(err or "")
                dialog.run()
                dialog.destroy()
            return False

    win = UsbWakeupWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


def main(argv):
    if not argv:
        return run_text_menu()

    if argv[0] == "gui":
        return run_gui()

    if argv[0] == "list":
        return run_cli_list()

    if argv[0] in ("enable", "disable"):
        if len(argv) < 2:
            print(T["usage_set"].format(cmd=argv[0]), file=sys.stderr)
            return 1
        return run_cli_set(argv[1], argv[0] == "enable")

    if argv[0] in ("-h", "--help"):
        print(T["help"])
        return 0

    print(T["unknown_command"].format(cmd=argv[0]), file=sys.stderr)
    print(T["help"])
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
