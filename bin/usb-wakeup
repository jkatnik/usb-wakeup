#!/usr/bin/env python3
import curses
import json
import locale
import os
import subprocess
import sys

HELPER_SCRIPT = "/usr/local/bin/usb-wakeup-helper.sh"
SYSFS_USB_ROOT = "/sys/bus/usb/devices"
LABELS_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "usb-wakeup", "labels.json",
)

